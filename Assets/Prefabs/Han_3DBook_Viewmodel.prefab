  guestRegistry:
  - guestName: Florin din Vatra
    portrait: {fileID: 21300000, guid: 56674e7caff1d4f649736f1212d04f4c, type: 3}
    roomNumber: 3
    arrivalTime: Sunset
    hasHorse: 1
    isCheckedIn: 1
    notes: "Negu\u021B\u0103tor din Moldova. A sosit cu butoaie ferecate cu sare.
      Calul s\u0103u murg trebuie \u021Binut \xEEn grajdul de r\u0103s\u0103rit.
      Miros u\u0219or de t\u0103m\xE2ie \u0219i p\u0103m\xE2nt reav\u0103n."
    signatureStamp: {fileID: 0}
  - guestName: "Gheorghe Str\u0103inul"
    portrait: {fileID: 21300000, guid: 711a0d28071b41bfa11cc1900696b607, type: 3}
    roomNumber: 6
    arrivalTime: Dusk
    hasHorse: 0
    isCheckedIn: 1
    notes: "C\u0103l\u0103tor singuratic pe jos prin codru. Nu pare tulburat de urlatul
      lupilor. Evit\u0103 oglinzile din han \u0219i poart\u0103 un medalion ruginit
      din argint."
    signatureStamp: {fileID: 0}
  - guestName: Doamna Ilinca
    portrait: {fileID: 21300000, guid: 711a0d28071b41bfa11cc1900696b607, type: 3}
    roomNumber: 2
    arrivalTime: Midnight
    hasHorse: 1
    isCheckedIn: 0
    notes: "Sosit\u0103 cu pu\u021Bin \xEEnainte de miezul nop\u021Bii. Refuz\u0103
      s\u0103-\u0219i ridice v\u0103lul negru de doliu. A cerut crengi de scoru\u0219
      \u0219i sare la pragul od\u0103ii."
    signatureStamp: {fileID: 0}
  currentPageIndex: 0

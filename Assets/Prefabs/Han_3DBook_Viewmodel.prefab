    responseHorse: 
    responseRoad: 
    responseIdentity: 
    roomNumber: 2
    arrivalTime: Midnight
    hasHorse: 1
    horseStallIndex: -1
    isCheckedIn: 0
    notes: "Sosit\u0103 cu pu\u021Bin \xEEnainte de miezul nop\u021Bii. Refuz\u0103
      s\u0103-\u0219i ridice v\u0103lul negru de doliu. A cerut crengi de scoru\u0219
      \u0219i sare la pragul od\u0103ii."
